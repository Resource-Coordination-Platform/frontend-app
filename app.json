{
  "expo": {
    "name": "Sahasra",
    "slug": "sahasra",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/shield-app-icon.png",
    "scheme": "sahasra",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "infoPlist": { "UIBackgroundModes": ["fetch"] }
    },
    "android": {
      "icon": "./assets/images/shield-app-icon.png",
      "predictiveBackGestureEnabled": false,
      "package": "com.kairaxdreamlabs.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/shield-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F6F2",
          "dark": {
            "backgroundColor": "#F7F6F2"
          }
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07ea50c2-b0a3-4d91-96da-7e45566029c5"
      }
    },
    "owner": "kairaxdreamlabss-team"
  }
}
